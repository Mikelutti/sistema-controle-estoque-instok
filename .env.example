# .env.example
#
# Modelo de variaveis de ambiente do Sistema de Controle de Estoque.
# Copie este arquivo para ".env" e preencha com valores reais.
#
# IMPORTANTE:
# - Este arquivo NAO deve conter nenhuma credencial real.
# - O arquivo ".env" (com dados reais) nunca deve ser versionado
#   (ja esta listado no .gitignore).

# Chave secreta da aplicacao Flask (sessions, protecao CSRF, etc.)
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# Ambiente de execucao da aplicacao: development | testing | production
FLASK_ENV=development

# Habilita/desabilita o modo debug do Flask (usar apenas em desenvolvimento)
FLASK_DEBUG=True

# Caminho do arquivo do banco de dados SQLite (dentro da pasta instance/)
DATABASE_PATH=instance/controle_estoque.db
