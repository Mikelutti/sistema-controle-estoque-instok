# Exemplo de variaveis de ambiente. Nao inclua credenciais reais neste arquivo.
# run.py NAO carrega .env automaticamente: defina as variaveis no PowerShell
# conforme README.md ou no ambiente do processo que inicia a aplicacao.
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DATABASE_PATH=instance/controle_estoque.db
FLASK_DEBUG=false
# Use true quando a aplicacao for servida exclusivamente por HTTPS.
SESSION_COOKIE_SECURE=false
